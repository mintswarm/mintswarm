#!/usr/bin/env python3
"""The pre-commit hook: format the staged files before git commits them.

Install it with `git config core.hooksPath .mintswarm/dogfood/hooks`. It runs
.mintswarm/dogfood/commit.py --hook from its own resolved location, which
refuses partially staged and unmerged paths, runs the declared formatters
whose paths match a staged path, re-stages the staged paths and puts back
any other file a formatter changed. It refuses `git commit <paths>`: stage
the paths and run plain `git commit`. Its exit status is commit.py's: 0 lets
git commit, anything else stops the commit.
"""

import os
import sys
from pathlib import Path

HELPER = Path(__file__).resolve().parent.parent / "commit.py"

if __name__ == "__main__":
    os.execv(sys.executable, [sys.executable, str(HELPER), "--hook"])
