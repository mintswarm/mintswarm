#!/usr/bin/env python3
"""Stand-in for mikefarah yq in the Linux check image, built on PyYAML.

Accepts only "yq -o=json . FILE", the one form reclassify.py and msw-state.py
use (with FILE /dev/stdin) and ../../project-setup.py uses (with FILE its
project-setup.yaml), and refuses anything else, so a new use of yq fails loudly instead of differing
from the real tool.
"""
import json
import sys

import yaml

if len(sys.argv) != 4 or sys.argv[1:3] != ["-o=json", "."]:
    sys.stderr.write("yq (stand-in): only 'yq -o=json . FILE' is supported\n")
    sys.exit(2)
try:
    with open(sys.argv[3]) as f:
        data = yaml.safe_load(f)
except (OSError, yaml.YAMLError) as e:
    sys.stderr.write("yq (stand-in): %s\n" % e)
    sys.exit(1)
json.dump(data, sys.stdout, indent=2)
sys.stdout.write("\n")
