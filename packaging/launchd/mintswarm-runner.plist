<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- A launchd agent for one mintswarm runner directory, rendered by `mintswarm-runner add-service`. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>{{label}}</string>
	<key>ProgramArguments</key>
	<array>
		<string>{{program}}</string>
		<string>run</string>
	</array>
	<key>WorkingDirectory</key>
	<string>{{working_directory}}</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
</dict>
</plist>
